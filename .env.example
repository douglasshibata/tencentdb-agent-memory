# TencentDB Agent Memory Environment Configuration
# Copy this file to .env and adjust variables accordingly.

# TencentDB / Tencent VectorDB configuration
TENCENTDB_HOST=10.0.0.1
TENCENTDB_PORT=80
TENCENTDB_USERNAME=root
TENCENTDB_KEY=your_secret_api_key_here
TENCENTDB_DATABASE_NAME=agent_memory_db
TENCENTDB_COLLECTION_NAME=memories
TENCENTDB_REGION=ap-guangzhou

# AI & Embedding models configuration
# Supports "mock", "openai", "hunyuan", or "huggingface"
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-embedding-v1
OPENAI_API_KEY=your_openai_api_key
HUNYUAN_SECRET_ID=your_hunyuan_secret_id
HUNYUAN_SECRET_KEY=your_hunyuan_secret_key

# Memory settings
MEMORY_DEDUPLICATION_THRESHOLD=0.85
MEMORY_DECAY_RATE=0.05
MEMORY_SHORT_TERM_LIMIT=10

# Running Mode: set to True for offline local simulations without Tencent Cloud
MOCK_MODE=True
